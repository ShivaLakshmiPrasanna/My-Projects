#define MAX 100

typedef struct {
    int a[MAX];
    int top;
} Stack;

typedef struct {
    Stack *s1;
    Stack *s2;
} MyQueue;

void stackinit(Stack *s) {
    s->top = -1;
}
MyQueue* myQueueCreate() {
    MyQueue *q = (MyQueue *)malloc(sizeof(MyQueue));
    q->s1 = (Stack *)malloc(sizeof(Stack));           // allocate memory for s1
    q->s2 = (Stack *)malloc(sizeof(Stack));           // allocate memory for s2

    stackinit(q->s1);
    stackinit(q->s2);

    return q;
}

bool IsStackEmpty(Stack *s) {
    if(s->top == -1) {
        return true;
    }

    return false;
}

bool IsStackFull(Stack *s) {
    if (s->top == MAX - 1) {
        return true;
    }

    return false;
}

void push(Stack *s, int val) {
    s->a[++s->top] = val;
}

int pop(Stack *s) {
    int value = s->a[s->top];
    s->top--;

    return value;
}

int peek(Stack *s) {
    
    return s->a[s->top];
}
void myQueuePush(MyQueue* obj, int x) {
    push(obj->s1,x);
}

int myQueuePop(MyQueue* obj) {
    Stack *temp = (Stack *)malloc(sizeof(Stack));
    int val = 0;

    memcpy(temp,obj->s1,sizeof(Stack));

    printf("%d \n",obj->s2->top);
    while(temp->top >= 0) {
        push(obj->s2,temp->a[temp->top]);
        temp->top--;
    }
    
    val = pop(obj->s2);

    int i = obj->s1->top;
    while(i >= 0 ) {
        obj->s1->a[obj->s1->top - i] = obj->s1->a[obj->s1->top - i + 1];
        i--;
    }

    obj->s1->top--;
    obj->s2->top = -1;
    
    
    return  val;
}

int myQueuePeek(MyQueue* obj) {
    Stack *temp = (Stack *)malloc(sizeof(Stack));

    memcpy(temp,obj->s1,sizeof(Stack));

    int val = 0;

    while(temp->top >= 0) {
        push(obj->s2,temp->a[temp->top]);
        temp->top--;
    }
    
    val = peek(obj->s2);
    obj->s2->top = -1;
    
    return  val;
    
}

bool myQueueEmpty(MyQueue* obj) {
    //printf("%d %d \n",obj->s2->top,IsStackEmpty(obj->s2));
    if (IsStackEmpty(obj->s1) && IsStackEmpty(obj->s2)) {
          return true;
    }
      
    return false;
}

void myQueueFree(MyQueue* obj) {
    obj->s1->top = -1;
    obj->s2->top = -1;
}

