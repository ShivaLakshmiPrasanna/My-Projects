
#include <stdio.h>
void swap(int *a, int *b) {
    int temp = *b;
    *b = *a;
    *a = temp;
}
int main() {
   int a[] = {6, 5, 1 ,3};
   int n = sizeof(a)/sizeof(a[0]);
   int i,j;
   
   for(i=n-1;i>0;i--) {
       for(j=0;j<i;j++) {
           if(a[j] > a[j+1]) {
               swap(&a[j],&a[j+1]);
           }
       }
   }
   printf("sorted array is \n\r");
   for(i=0;i<n;i++) {
    printf("%d ",a[i]);
   }
    return 0;
}
